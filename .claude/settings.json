      "Bash(supabase migration repair:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase link:*)",
      "Bash(pnpm deploy:migrate:*)",
      "Bash(node scripts/deploy/migrate.mjs:*)",
      "Bash(pnpm demo:seed:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
