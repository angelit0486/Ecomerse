      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm prettier:*)",
      "Bash(pnpm eslint:*)",
      "Bash(pnpm tsc:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
