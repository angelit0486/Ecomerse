# =============================================================================
# Variables de entorno — plantilla. Copia a .env.local (ignorado por git).
# Nunca subas valores reales. En Vercel se configuran por entorno.
# Validación: src/config/env.ts (el build falla si falta o es inválida una variable).
# =============================================================================

# development | test | preview | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# Rol system_worker vía Supavisor (modo transacción, puerto 6543 en Supabase).
# Runbook: docs/runbooks/database-roles.md
WORKER_DATABASE_URL=postgres://system_worker:CAMBIAR@localhost:5432/postgres

# Vercel Cron envía "Authorization: Bearer <CRON_SECRET>". Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
CRON_SECRET=
# HMAC para disparos firmados del runner de jobs (pg_cron + pg_net). Mínimo 32.
JOBS_HMAC_SECRET=

# Supabase (en local: `pnpm stack env` imprime estos valores del stack sin Docker).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rol storefront_gateway (solo funciones storefront.*). Runbook: docs/runbooks/database-roles.md
GATEWAY_DATABASE_URL=postgres://storefront_gateway:CAMBIAR@localhost:5432/postgres

# Host del panel (sin protocolo). Cualquier otro host se trata como tienda.
# En local las tiendas se abren en http://{handle}.localhost:3000
APP_HOSTNAME=localhost:3000
# HMAC de los tokens de vista previa (mínimo 32). Generar con: openssl rand -hex 32
PREVIEW_HMAC_SECRET=
# HMAC de los enlaces de pedido del invitado y del pago simulado (mínimo 32).
ORDER_LINK_SECRET=
# Stripe Connect de la plataforma (opcional hasta tener la cuenta): sk_test_… y whsec_…
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Stripe Billing (ADR-044): secreto del webhook del cobro de suscripciones (/api/webhooks/billing/stripe)
STRIPE_BILLING_WEBHOOK_SECRET=
# Mercado Pago de la plataforma (opcional hasta tener las credenciales; ADR-028):
# access token (APP_USR-… o TEST-…) y la clave secreta de la firma de webhooks.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Mercado Pago por tienda (ADR-041, opcional): cada comercio conecta SU cuenta y el dinero
# le llega directo. Client ID y Client Secret de la aplicación, y una clave que cifra las
# llaves de los comercios en la base. Generar con: openssl rand -base64 32
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
PAYMENT_CREDENTIALS_KEY=
# Dominios propios (E16, opcional): token de Vercel limitado a este proyecto, id del
# proyecto (prj_…) y del equipo (team_…, si aplica). Registros DNS que se indican a la
# tienda (los muestra Vercel al agregar un dominio): destino CNAME e IP del apex.
VERCEL_DOMAINS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
DOMAIN_CNAME_TARGET=
DOMAIN_APEX_A=
# Send Email Hook de Supabase Auth (opcional): v1,whsec_… (el mismo secreto en Auth → Hooks).
SEND_EMAIL_HOOK_SECRET=

# Enlaces en emails: origen público del panel.
APP_URL=http://localhost:3000
# Canal de email: resend (producción/preview, obligatorio) | mailpit (local) | fake (pruebas)
EMAIL_PROVIDER=mailpit
EMAIL_FROM="Plataforma <no-reply@plataforma.local>"
# Solo con EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Opcional: secreto de firma del webhook de Resend (rebotes y quejas → /api/webhooks/email/resend)
RESEND_WEBHOOK_SECRET=
# Solo con EMAIL_PROVIDER=mailpit (API HTTP de Mailpit del stack local)
MAILPIT_URL=http://127.0.0.1:8025

# service_role de Supabase: SOLO src/server/privileged (Auth Admin y Storage Admin;
# nunca toca tablas). Obligatoria en producción; sin ella no se procesan fotos.
SUPABASE_SERVICE_ROLE_KEY=
# Solo vista previa: tiendas de demostración en la portada del panel,
# "Etiqueta|https://host,…". En producción se ignora.
PREVIEW_STORE_LINKS=

# -----------------------------------------------------------------------------
# Solo despliegue (no la lee la app): si existe, `pnpm build` aplica las migraciones
# pendientes con scripts/deploy/migrate.mjs. Usar el Session pooler (puerto 5432).
# Runbook: docs/runbooks/database-roles.md
MIGRATION_DATABASE_URL=

# -----------------------------------------------------------------------------
# Solo pruebas locales y CI: apuntan las API externas a simuladores locales.
# En staging y producción se dejan vacías (se usan las API reales).
# STRIPE_API_BASE=http://127.0.0.1:4599
# MERCADOPAGO_API_BASE=
# MERCADOPAGO_AUTH_BASE=
# VERCEL_API_BASE=
