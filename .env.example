# =============================================================================
# Variables de entorno — plantilla. Copia a .env.local (ignorado por git).
# Nunca subas valores reales. En Vercel se configuran por entorno.
# Validación: src/config/env.ts (el build falla si falta o es inválida una variable).
# =============================================================================

# development | test | preview | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# Rol system_worker vía Supavisor (modo transacción, puerto 6543 en Supabase).
# Runbook: docs/runbooks/database-roles.md
WORKER_DATABASE_URL=postgres://system_worker:CAMBIAR@localhost:5432/postgres

# Vercel Cron envía "Authorization: Bearer <CRON_SECRET>". Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
CRON_SECRET=
# HMAC para disparos firmados del runner de jobs (pg_cron + pg_net). Mínimo 32.
JOBS_HMAC_SECRET=

# Supabase (en local: `pnpm stack env` imprime estos valores del stack sin Docker).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rol storefront_gateway (solo funciones storefront.*). Runbook: docs/runbooks/database-roles.md
GATEWAY_DATABASE_URL=postgres://storefront_gateway:CAMBIAR@localhost:5432/postgres

# Host del panel (sin protocolo). Cualquier otro host se trata como tienda.
# En local las tiendas se abren en http://{handle}.localhost:3000
APP_HOSTNAME=localhost:3000
# HMAC de los tokens de vista previa (mínimo 32). Generar con: openssl rand -hex 32
PREVIEW_HMAC_SECRET=
# HMAC de los enlaces de pedido del invitado y del pago simulado (mínimo 32).
ORDER_LINK_SECRET=
# Stripe Connect de la plataforma (opcional hasta tener la cuenta): sk_test_… y whsec_…
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Send Email Hook de Supabase Auth (opcional): v1,whsec_… (el mismo secreto en Auth → Hooks).
SEND_EMAIL_HOOK_SECRET=

# Enlaces en emails: origen público del panel.
APP_URL=http://localhost:3000
# Canal de email: resend (producción/preview, obligatorio) | mailpit (local) | fake (pruebas)
EMAIL_PROVIDER=mailpit
EMAIL_FROM="Plataforma <no-reply@plataforma.local>"
# Solo con EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Solo con EMAIL_PROVIDER=mailpit (API HTTP de Mailpit del stack local)
MAILPIT_URL=http://127.0.0.1:8025
