# =============================================================================
# Variables de entorno — plantilla. Copia a .env.local (ignorado por git).
# Nunca subas valores reales. En Vercel se configuran por entorno.
# Validación: src/config/env.ts (el build falla si falta o es inválida una variable).
# =============================================================================

# development | test | preview | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# Rol system_worker vía Supavisor (modo transacción, puerto 6543 en Supabase).
# Runbook: docs/runbooks/database-roles.md
WORKER_DATABASE_URL=postgres://system_worker:CAMBIAR@localhost:5432/postgres

# Vercel Cron envía "Authorization: Bearer <CRON_SECRET>". Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
CRON_SECRET=
# HMAC para disparos firmados del runner de jobs (pg_cron + pg_net). Mínimo 32.
JOBS_HMAC_SECRET=

# Supabase (en local: `pnpm stack env` imprime estos valores del stack sin Docker).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rol storefront_gateway (solo funciones storefront.*). Runbook: docs/runbooks/database-roles.md
GATEWAY_DATABASE_URL=postgres://storefront_gateway:CAMBIAR@localhost:5432/postgres
